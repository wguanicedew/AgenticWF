# Caddy's environment for the AgenticWF site files: install as /etc/caddy/agenticwf.env and load
# it into the caddy service with a systemd drop-in (README.md, Caddy on the host).
# These are Caddy's settings, not the container's (container/agenticwf.env.example).

AGENTICWF_ACME_EMAIL=ops@example.org

# Layout A: agenticwf-single-host.caddyfile
AGENTICWF_HOST=host.example.org
# With the agenticwf-admin-console.caddyfile add-on or the Jaeger UI: the networks allowed to reach them.
# AGENTICWF_ADMIN_ALLOWED_CIDRS="10.0.0.0/8 192.168.0.0/16"

# Layout B: agenticwf-multi-host.caddyfile (instead of AGENTICWF_HOST)
# AGENTICWF_LOGTO_HOST=auth.example.org
# AGENTICWF_LOGTO_ADMIN_HOST=auth-admin.example.org
# AGENTICWF_APP_HOST=app.example.org
# AGENTICWF_ADMIN_ALLOWED_CIDRS="10.0.0.0/8 192.168.0.0/16"

# Tracing (README.md, Tracing): with deploy/caddy/tracing/agenticwf-tracing.caddy in
# /etc/caddy/tracing.d/, to Jaeger (compose.jaeger.yaml) on 127.0.0.1:4317. OTLP over gRPC works
# with every Caddy version (EL9's 2.6 knows no other).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_EXPORTER_OTLP_INSECURE=true
# OTEL_SERVICE_NAME=caddy
# The Jaeger UI without Logto (deploy/caddy/jaeger-ui/agenticwf-jaeger-ui.caddy or
# agenticwf-jaeger-ui-network.caddy) is limited to AGENTICWF_ADMIN_ALLOWED_CIDRS.
