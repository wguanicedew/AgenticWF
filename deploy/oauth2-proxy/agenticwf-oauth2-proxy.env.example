# Secrets for oauth2-proxy (/etc/oauth2-proxy/agenticwf.env, mode 0600, root-owned; read by
# systemd before it drops privileges). OAUTH2_PROXY_<OPTION> overrides <option> in the .cfg.

# The CILogon client (https://cilogon.org/oauth2/register), with the redirect URI
# https://idds01.sdcc.bnl.gov/oauth2/callback.
OAUTH2_PROXY_CLIENT_ID=cilogon:/client_id/CHANGE_ME
OAUTH2_PROXY_CLIENT_SECRET=CHANGE_ME

# 32 random bytes, base64url (the role of mod_auth_openidc's OIDCCryptoPassphrase):
#   openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=CHANGE_ME
