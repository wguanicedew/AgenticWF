# The service repos this image is built from: where they are, and which ref to build
# (a branch, tag or commit). scripts/fetch-sources.sh checks them out into .src/; the CI workflow
# reads the same file. Pin tags or commits for releases, so a commit of this repo always builds the
# same image. Overrides for one build: AUTH_REF=v0.2.0 scripts/fetch-sources.sh
AUTH_REPO=https://github.com/wguanicedew/AgenticWF-auth.git
AUTH_REF=main
# The identity providers of authsvc (both go into the image; AGENTICWF_AUTH_PROVIDER picks one).
AUTH_LOGTO_REPO=https://github.com/wguanicedew/AgenticWF-auth-logto.git
AUTH_LOGTO_REF=main
AUTH_KEYCLOAK_REPO=https://github.com/wguanicedew/AgenticWf-auth-keycloak.git
AUTH_KEYCLOAK_REF=main
KB_REPO=https://github.com/wguanicedew/AgenticWF-KB.git
KB_REF=main
AGENT_REPO=https://github.com/wguanicedew/AgenticWF-agent.git
AGENT_REF=main
