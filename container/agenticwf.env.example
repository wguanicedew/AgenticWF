# Runtime configuration for the all-in-one agenticwf container (docker/podman --env-file).
# Install as /etc/agenticwf/agenticwf.env (mode 0600: it may hold secrets). Recreate the container
# after changing it; `docker restart` does not re-read it.
# Settings of the knowledge service and the agent (models, retrieval, ...) are in
# /etc/agenticwf/kb.cfg and /etc/agenticwf/agent.cfg; mount your own files over them to change them.

# The image runs the shared deployment by default (AGENTICWF_MODE=server; `local` is the personal
# mode, compose.local.yaml). Which services run besides the identity provider and authsvc:
# "agent kb" (default), "kb" (a knowledge base alone) or "agent" (no KB: its knowledge tools are off).
# AGENTICWF_SERVICES=agent kb

# The identity provider authsvc uses; both are in the image, only this one runs:
#   logto     (default) Logto OSS: the "Auth (Logto + authsvc)" settings below and the Caddy site
#             files deploy/caddy/sites/agenticwf-{single,multi}-host.caddyfile
#   keycloak  Keycloak under /idp: the "Auth (Keycloak + authsvc)" settings further down and
#             deploy/caddy/sites/agenticwf-keycloak-{single,multi}-host.caddyfile
# Each keeps its users in its own database: switching on an existing volume starts with no users.
# authsvc settings that differ between the two carry the provider as a prefix, so both sections can
# stay filled in: LOGTO_AUTH_X / KEYCLOAK_AUTH_X become authsvc's AUTH_X for that provider only
# (AUDIENCES, WEB_SCOPES, WEB_CLIENT_ID, MGMT_CLIENT_ID, CLI_CLIENT_ID, ACCOUNT_URL, ROLES_CLAIM).
# A plain AUTH_X still works too and applies to whichever provider runs.
# AGENTICWF_AUTH_PROVIDER=logto

# --- Auth (Logto + authsvc) --------------------------------------------------------------------
# Public URLs served by host Caddy (deploy/caddy/). Match the layout you installed:
#   A) deploy/caddy/sites/agenticwf-single-host.caddyfile (below)
#   B) deploy/caddy/sites/agenticwf-multi-host.caddyfile:
#        LOGTO_ENDPOINT=https://auth.example.org   LOGTO_ADMIN_ENDPOINT=https://auth-admin.example.org
#        APP_ORIGIN=https://app.example.org        APP_BASE_PATH=
LOGTO_ENDPOINT=https://host.example.org
LOGTO_ADMIN_ENDPOINT=http://localhost:3002
# The API resource indicator: a URI used only as a name (the tokens' audience). Logto's API
# resource is created with it (LOGTO_BOOTSTRAP). Add `urn:logto:organization:*` to accept
# organization tokens.
LOGTO_AUTH_AUDIENCES=https://host.example.org/app/api

# Browser login. The redirect URI ${APP_ORIGIN}${APP_BASE_PATH}/auth/callback and the sign-out
# URI ${APP_ORIGIN}${APP_BASE_PATH}/ are set on the "AgenticWF Web" app by LOGTO_BOOTSTRAP.
APP_ORIGIN=https://host.example.org
APP_BASE_PATH=/app
# Logto grants each user only what their roles allow, so `admin` (the Jaeger UI, admin pages)
# reaches only users with the admin role.
LOGTO_AUTH_WEB_SCOPES=openid profile email offline_access app:access agent:use knowledge:read knowledge:write code:read admin
# Only for a web app you made yourself in the Logto console; otherwise LOGTO_BOOTSTRAP creates it.
# LOGTO_AUTH_WEB_CLIENT_ID=
# AUTH_WEB_CLIENT_SECRET=    # moved into /var/lib/agenticwf/secrets on first boot

# --- Logto configuration at startup (LOGTO_BOOTSTRAP) ------------------------------------------
# On every start, after Logto is up, the container makes sure Logto has what is listed here (it
# never deletes anything; what is not listed stays as configured in the console). README.md, Logto.
# LOGTO_BOOTSTRAP=true                     # false: configure everything in the Logto console
# API resource and its permissions (scopes)
# LOGTO_API_NAME=AgenticWF API
# LOGTO_API_SCOPES=app:access agent:use knowledge:read knowledge:write code:read dataset:read dataset:write compute:submit admin
# LOGTO_API_TOKEN_TTL=3600
# User roles: name=permissions; ...   (* = every permission of the API resource)
# LOGTO_ROLES=researcher=app:access agent:use knowledge:read knowledge:write code:read dataset:read; admin=*
# Roles every new user gets. Empty (default): new users wait until an admin assigns a role.
# LOGTO_DEFAULT_ROLES=
# Applications: "AgenticWF Web" (browser login) and "agenticwf CLI" (device flow) are created;
# CLI settings for laptops end up in /var/lib/agenticwf/logto/clients.env.
# LOGTO_WEB_APP_NAME=AgenticWF Web
# LOGTO_CLI_APP=true
# LOGTO_CLI_APP_NAME=agenticwf CLI
# Machine-to-machine apps: name=permissions; ...  Credentials: /var/lib/agenticwf/secrets/logto-apps/<name>.env
# LOGTO_M2M_APPS=pipeline=app:access knowledge:read knowledge:write
# Sign-up: email (email + password, the email verified by a code; password reset by email; needs
# the email connector below), closed (no self-registration), or unmanaged (set in the console).
# LOGTO_SIGNUP=email
# Also ask for a username at sign-up (it names what a user owns, e.g. knowledge bases
# `username:kb-name`); off: email only. Either one signs in.
# LOGTO_SIGNUP_USERNAME=on
# Admin accounts, created on boot (README.md, Logto). The passwords are moved into
# /var/lib/agenticwf/secrets on first boot and set again on every boot: change them here, not in
# Logto. Delete the secrets file (logto_console_admin_password, logto_app_admin_password) to stop.
# Logto admin console account (instead of whoever opens the console first); console sign-up closes.
# LOGTO_CONSOLE_ADMIN_USERNAME=admin
# LOGTO_CONSOLE_ADMIN_PASSWORD=
# AgenticWF admin user: signs in with this email and password. Without a password, an existing
# user with this email (e.g. after sign-up) just gets the roles.
# LOGTO_APP_ADMIN_EMAIL=ops@example.org
# LOGTO_APP_ADMIN_PASSWORD=
# LOGTO_APP_ADMIN_ROLES=admin               # from LOGTO_ROLES
# Groups (Logto organizations; admin page, Groups) and personal access tokens: authsvc's Management
# API app "AgenticWF Management" and the organization roles admin / member are created; off: neither.
# LOGTO_MANAGEMENT_APP=true
# AUTH_GROUP_ADMIN_ROLE=admin
# AUTH_GROUP_MEMBER_ROLE=member
# AUTH_GROUP_CACHE_TTL=60                   # seconds before a membership change applies
# Access tokens carry `roles` and `external_identity.groups` (IdP groups) for the KB's sharing.
# LOGTO_CUSTOM_JWT=true
# Logto's account pages for users: $LOGTO_ENDPOINT/account/profile, /account/security,
# /account/sessions. on, off, or unmanaged (set in the console). The fields are field=Off|ReadOnly|Edit
# (name avatar profile email phone password username social customData mfa passkey session
# trustedDevice); fields not listed keep their console setting. avatar=Edit needs a storage
# provider in Logto for the upload.
# LOGTO_ACCOUNT_CENTER=on
# LOGTO_ACCOUNT_CENTER_FIELDS=name=Edit email=Edit password=Edit username=ReadOnly social=Edit mfa=Edit passkey=Edit session=Edit
# The web UI links the user's name to $LOGTO_ENDPOINT/account (unless off); set LOGTO_AUTH_ACCOUNT_URL
# to point elsewhere, or LOGTO_AUTH_ACCOUNT_URL= (empty) to hide the link.
# LOGTO_AUTH_ACCOUNT_URL=

# Optional: generated on first boot into /var/lib/agenticwf/secrets if unset.
# LOGTO_DB_PASSWORD=
# AUTHSVC_DB_PASSWORD=
# AUTH_CONTEXT_SECRET=

# --- Auth (Keycloak + authsvc), AGENTICWF_AUTH_PROVIDER=keycloak -------------------------------
# Public URLs served by host Caddy. Keycloak lives under /idp (fixed at image build, KEYCLOAK_PATH);
# the application is at the root of its hostname (APP_BASE_PATH empty), or under a path such as
# APP_BASE_PATH=/app: then set the same AGENTICWF_APP_BASE_PATH=/app in Caddy's environment
# (deploy/caddy/agenticwf-caddy.env.example). Comment out the Logto section's APP_BASE_PATH=/app
# above unless you want /app. Match the layout:
#   A) deploy/caddy/sites/agenticwf-keycloak-single-host.caddyfile:
#        KEYCLOAK_URL=https://host.example.org/idp   APP_ORIGIN=https://host.example.org
#   B) deploy/caddy/sites/agenticwf-keycloak-multi-host.caddyfile:
#        KEYCLOAK_URL=https://auth.example.org/idp   APP_ORIGIN=https://app.example.org
# KEYCLOAK_URL=https://host.example.org/idp
# APP_ORIGIN=https://host.example.org
# APP_BASE_PATH=                         # or /app, the same as Caddy's AGENTICWF_APP_BASE_PATH
# Keycloak's admin console: on KEYCLOAK_URL (/idp/admin/), which Caddy restricts to
# AGENTICWF_ADMIN_ALLOWED_CIDRS; or only through an SSH tunnel (ssh -L 8080:127.0.0.1:8080 host):
# KEYCLOAK_ADMIN_URL=http://localhost:8080/idp
# With it, every boot also sets the master realm's Frontend URL to it (keycloak-bootstrap), since
# the console signs in through the master realm; the master realm is then only usable on that URL.
# Without it, that Frontend URL is cleared (KEYCLOAK_URL, under Caddy's CIDR restriction).
# The first (temporary) master-realm admin; its password is generated into
# /var/lib/agenticwf/secrets/keycloak_admin_password on first boot (or KEYCLOAK_ADMIN_PASSWORD).
# KEYCLOAK_ADMIN_USER=admin
# On first boot the AgenticWF realm is created (AgenticWF-auth-keycloak's realm template): the API
# client and its permissions, the roles `researcher` and `admin`, the browser-login client, the
# CLI's device-flow client and authsvc's Admin API client, with generated secrets. Later changes
# are made in Keycloak's admin console; these settings only shape the first import, except what
# keycloak-bootstrap applies on every boot: KEYCLOAK_REGISTRATION_ALLOWED (when set) and the scopes
# of the roles `researcher` and `admin` (added, never removed). The CLI settings for laptops end up
# in /var/lib/agenticwf/keycloak/clients.env.
# KEYCLOAK_REALM=agenticwf
# KEYCLOAK_PROVISION_REALM=1            # 0: bring your own realm and set the KEYCLOAK_AUTH_* client ids/secrets
# KEYCLOAK_REGISTRATION_ALLOWED=false   # true: anyone may register (and then awaits approval); applied every boot when set
# Sign-up asks for username, email and password. With KEYCLOAK_VERIFY_EMAIL=true the new user must
# click the link mailed to them before the first sign-in (needs the email settings below).
# KEYCLOAK_VERIFY_EMAIL=false           # applied every boot when set
# KEYCLOAK_RESET_PASSWORD_ALLOWED=false # true: "Forgot password?" by email; applied every boot when set
# Account Console roles every user gets (through default-roles-<realm>), ensured every boot; empty: leave them alone
# KEYCLOAK_ACCOUNT_ROLES="view-profile manage-account"
# Email (SMTP) of the AgenticWF realm, set on every boot (KEYCLOAK_EMAIL=off: leave it to the console).
# KEYCLOAK_EMAIL=smtp
# KEYCLOAK_EMAIL_FROM=agenticwf-noreply@host.example.org   # or "AgenticWF <addr>"; default: agenticwf-noreply@<host FQDN>
# CERN's mail gateway rejects senders at a host's own domain (550 TRANSPORT.RULES.RejectMessage):
# KEYCLOAK_EMAIL_FROM=agenticwf-noreply_myhost@cern.ch
# KEYCLOAK_EMAIL_BRAND=AgenticWF        # sender's display name
# KEYCLOAK_EMAIL_REPLY_TO=
# KEYCLOAK_SMTP_HOST=127.0.0.1          # the host's MTA (server mode runs with --network host)
# KEYCLOAK_SMTP_PORT=25
# KEYCLOAK_SMTP_TLS=none                # none (default on loopback) | starttls (default otherwise) | tls (465)
# KEYCLOAK_SMTP_USER=                   # empty: no SMTP AUTH
# KEYCLOAK_SMTP_PASSWORD=               # moved into /var/lib/agenticwf/secrets on first boot
# Scopes (API client roles) the realm roles include, made sure of on every boot:
# KEYCLOAK_RESEARCHER_SCOPES="app:access agent:use knowledge:read knowledge:write code:read dataset:read"
# KEYCLOAK_ADMIN_SCOPES="dataset:write compute:submit admin"   # plus everything `researcher` has
# KEYCLOAK_AUTH_AUDIENCES=agenticwf-api          # the API client id: the access tokens' audience
# KEYCLOAK_AUTH_WEB_CLIENT_ID=agenticwf-web       # browser login
# KEYCLOAK_AUTH_MGMT_CLIENT_ID=agenticwf-authsvc  # Admin API: groups, personal access tokens
# KEYCLOAK_AUTH_CLI_CLIENT_ID=agenticwf-cli       # `agenticwf login` (device flow); published at /auth/config
# Only OpenID scopes: Keycloak puts the permissions in the token from the user's realm roles, and
# rejects the whole sign-in (invalid_scope) for a scope it does not know, e.g. Logto's app:access.
# KEYCLOAK_AUTH_WEB_SCOPES=openid profile email
# KEYCLOAK_AUTH_ROLES_CLAIM=realm_access.roles
# AUTH_GROUP_ADMINS_NAME=admins
# Profile link next to the user's name; default: Keycloak's account console.
# KEYCLOAK_AUTH_ACCOUNT_URL=https://host.example.org/idp/realms/agenticwf/account
# Optional: generated on first boot into /var/lib/agenticwf/secrets if unset.
# KEYCLOAK_DB_PASSWORD=
# KEYCLOAK_ADMIN_PASSWORD=
# KEYCLOAK_LOG_LEVEL=info

# --- Email (Logto) ------------------------------------------------------------------------------
# On first boot an SMTP email connector is created in Logto (sign-up verification codes, "forgot
# password"), sending through the host's MTA (Postfix) on 127.0.0.1:25 without login. Afterwards
# change it in the Logto console (Connectors -> Email and SMS connectors); these settings are not
# applied again. To turn on email verification at sign-up, see README.md (Email).
# LOGTO_EMAIL_CONNECTOR=smtp                 # off: do not create one
# LOGTO_EMAIL_FROM=AgenticWF <agenticwf-noreply@host.example.org>   # default: the host's FQDN
# CERN's mail gateway rejects senders at a host's own domain (550 TRANSPORT.RULES.RejectMessage);
# use the <user>_<short host>@cern.ch form there:
# LOGTO_EMAIL_FROM=AgenticWF <agenticwf-noreply_myhost@cern.ch>
# LOGTO_EMAIL_REPLY_TO=
# LOGTO_EMAIL_BRAND=AgenticWF                # in subjects and texts
# LOGTO_SMTP_HOST=127.0.0.1
# LOGTO_SMTP_PORT=25
# LOGTO_SMTP_TLS=none                        # none (default on loopback) | starttls (default otherwise) | tls (465)
# Instead of the local MTA, e.g. CERN's SMTP service with a service account:
# LOGTO_SMTP_HOST=smtp.cern.ch
# LOGTO_SMTP_PORT=587
# LOGTO_SMTP_USER=agenticwf-noreply
# LOGTO_SMTP_PASSWORD=                       # moved into /var/lib/agenticwf/secrets on first boot

# --- Networking --------------------------------------------------------------------------------
# The container runs with `--network host`; the services listen on 127.0.0.1, where host Caddy
# reaches them. All ports below must be free on the host.
# LISTEN_HOST=127.0.0.1
# PGPORT=5432            # 127.0.0.1 only; change it if the host already uses 5432
# LOGTO_PORT=3001
# LOGTO_ADMIN_PORT=3002
# KEYCLOAK_PORT=8080             # update the Caddy site file too
# KEYCLOAK_MANAGEMENT_PORT=9000  # health only
# AUTHSVC_PORT=8010
# KB_PORT=8020
# AGENT_PORT=8000
# LOG_LEVEL=info

# --- Tracing ------------------------------------------------------------------------------------
# authsvc, the KB and the agent send OpenTelemetry traces over OTLP/HTTP to Jaeger
# (compose.jaeger.yaml, published on the host's 127.0.0.1:4318). Unset: no tracing. With Caddy's
# tracing on too, each request is one trace from Caddy down to the backend (README.md, Tracing).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# Don't set OTEL_SERVICE_NAME: it would name all services alike (defaults: agenticwf-auth,
# agenticwf-kb, agenticwf-kb-worker, agenticwf-agent, agenticwf-agent-worker).
# Keep a fraction of the traces the services start themselves (with `parentbased_`, a request
# traced by Caddy follows Caddy's decision):
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.25
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=prod

# --- Knowledge service ----------------------------------------------------------------------
# Must match `required_scopes` in policy.yaml.
# KB_REQUIRED_SCOPES=app:access
# The scopes the agent may forward for a user at most.
# KB_SERVICE_SCOPES_CAP=knowledge:read knowledge:write
# KB_WORKER_PROCESSES=0
# Web search (agentic search's smart preset), the LLM wiki and temporal memory: the kb.cfg
# [features] switches; the wiki and memory are also on for each new document KB (its owner can
# switch them off). They win over kb.cfg; false switches the feature off.
# KB_WEB=true
# KB_WIKI=true
# KB_MEMORY=true
# EMBEDDINGS_API_KEY=

# --- Agent ------------------------------------------------------------------------------------
# AGENT_REQUIRED_SCOPES=app:access
# AGENT_WORKER_PROCESSES=0
# Model provider keys, named by api_key_env in agent.cfg.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# TAVILY_API_KEY=
